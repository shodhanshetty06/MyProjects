# =============================================================================
# Root environment file — used by docker-compose to template all services.
# Copy to `.env` and fill in real values for local development.
# =============================================================================

# --- General ---
# local | development | staging | production
ENVIRONMENT=local
PROJECT_NAME="AI Job Search Platform"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DEBUG=true

# --- Security ---
SECRET_KEY=change-me-super-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=["http://localhost:5000"]

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=jobplatform
POSTGRES_PASSWORD=jobplatform
POSTGRES_DB=jobplatform
DATABASE_URL=postgresql+asyncpg://jobplatform:jobplatform@postgres:5432/jobplatform

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- AWS S3 — only needed when STORAGE_PROVIDER=s3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=job-platform-storage
# set for LocalStack/MinIO in local dev
S3_ENDPOINT_URL=

# --- Vector store (pgvector uses the same Postgres instance) ---
# Must match whatever EMBEDDING_PROVIDER/model is active — 384 for the
# default local provider (BAAI/bge-small-en-v1.5 / intfloat/e5-small-v2).
VECTOR_DIMENSIONS=384

# --- AI / Embedding / Storage / Email provider selection ---
# Switching providers is a .env-only change — no application code changes.
AI_PROVIDER=ollama          # ollama | anthropic | openai | gemini | groq
EMBEDDING_PROVIDER=local    # local | voyage | openai | gemini
STORAGE_PROVIDER=local      # local | s3
EMAIL_PROVIDER=smtp         # smtp | ses
AI_PROVIDER_MAX_RETRIES=3
AI_PROVIDER_RETRY_BACKOFF_SECONDS=1.0

# --- Ollama (primary AI provider) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODELS=llama3.1:8b,gemma3:12b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# --- Anthropic (Claude) — AI_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI — AI_PROVIDER=openai / EMBEDDING_PROVIDER=openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Gemini — AI_PROVIDER=gemini / EMBEDDING_PROVIDER=gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Groq — AI_PROVIDER=groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Voyage AI — EMBEDDING_PROVIDER=voyage ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- Local embeddings (sentence-transformers, primary embedding provider) ---
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Embedding cache (Redis, cache-aside via EmbeddingService) ---
EMBEDDING_CACHE_TTL_SECONDS=604800

# --- Local storage — STORAGE_PROVIDER=local (default) ---
# LOCAL_STORAGE_PATH is the in-container path (do not change for docker-compose).
# LOCAL_STORAGE_HOST_PATH is the host directory bind-mounted onto it — this is
# where uploaded resumes actually land on disk.
LOCAL_STORAGE_PATH=/app/storage
LOCAL_STORAGE_HOST_PATH=D:/resumes
LOCAL_STORAGE_BASE_URL=http://localhost:5000
LOCAL_STORAGE_URL_SIGNING_SECRET=

# --- SMTP — EMAIL_PROVIDER=smtp (default) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=notifications@jobplatform.example.com

# --- Resume parser ---
RESUME_MAX_UPLOAD_MB=10

# --- ATS Resume Generator ---
ATS_KEYWORD_SCORE_WEIGHT=0.6
ATS_STRUCTURE_SCORE_WEIGHT=0.4

# --- Job Ingestion ---
JOB_INGESTION_SWEEP_INTERVAL_MINUTES=360
JOB_INGESTION_STALE_CRAWL_HOURS=24
JOB_INGESTION_HTTP_TIMEOUT_SECONDS=30
JOB_INGESTION_MAX_JOBS_PER_RUN=500
JOB_INGESTION_USER_AGENT=JobPlatformBot/1.0 (+https://jobplatform.example.com)

# --- Auto Apply ---
AUTO_APPLY_MAX_ATTEMPTS=3
AUTO_APPLY_BROWSER_TIMEOUT_MS=30000
AUTO_APPLY_CONFIRMATION_WAIT_MS=2000
AUTO_APPLY_WORKDAY_MAX_STEPS=6

# --- Gmail / Email Tracking ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/email-tracking/gmail/callback
GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_OAUTH_SUCCESS_REDIRECT_URL=
GMAIL_OAUTH_FAILURE_REDIRECT_URL=
GMAIL_OAUTH_STATE_TTL_SECONDS=600
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_SYNC_INTERVAL_MINUTES=10
GMAIL_MAX_MESSAGES_PER_SYNC=50
GMAIL_API_TIMEOUT_SECONDS=20
EMAIL_TRACKING_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
EMAIL_TRACKING_MATCH_CONFIDENCE_THRESHOLD=0.72
EMAIL_TRACKING_MATCH_MARGIN=0.15
EMAIL_TRACKING_MATCH_LOW_SCORE_FLOOR=0.3
EMAIL_TRACKING_MATCH_LOOKBACK_DAYS=180
EMAIL_TRACKING_COMPANY_MATCH_WEIGHT=0.7
EMAIL_TRACKING_TITLE_MATCH_WEIGHT=0.3

# --- Notification (NOTIFICATION_SES_* only used when EMAIL_PROVIDER=ses) ---
NOTIFICATION_SES_SENDER_EMAIL=notifications@jobplatform.example.com
NOTIFICATION_SES_CONFIGURATION_SET=
NOTIFICATION_DEFAULT_CHANNELS=in_app,email
NOTIFICATION_MAX_RETRIES=3

# --- AI Career Coach ---
AI_CAREER_COACH_CHAT_MAX_HISTORY_MESSAGES=20
AI_CAREER_COACH_MARKET_TREND_WINDOW_DAYS=90
AI_CAREER_COACH_SALARY_SAMPLE_LIMIT=200
AI_CAREER_COACH_SALARY_MIN_SAMPLE_SIZE=3

# --- Frontend ---
# Relative path so the browser always calls back through the nginx proxy
# on http://localhost:5000 instead of a second host:port.
VITE_API_BASE_URL=/api/v1
