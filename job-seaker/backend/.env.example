# Backend-local override of the root .env — see the repo root .env.example
# for the full documented list. Docker Compose injects these automatically;
# this file is only needed when running `uvicorn` outside of Docker.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://jobplatform:jobplatform@localhost:5432/jobplatform
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Outside Docker there's no bind mount, so point straight at the host path.
LOCAL_STORAGE_PATH=D:/resumes
